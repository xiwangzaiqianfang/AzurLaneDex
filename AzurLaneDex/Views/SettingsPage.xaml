<Page x:Class="AzurLaneDex.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,12" Spacing="12">
            <TextBlock x:Uid="SettingsPageTitle" Text="设置" FontSize="28" FontWeight="SemiBold" Margin="10,10,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20" Spacing="12">

                <!-- 窗口设置卡片 -->
                <Border Style="{StaticResource CardStyleStretch}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Setting_Window_Title" Text="窗口设置" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WindowSizeLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Uid="Setting_Window_Button" Content="重置窗口大小" Click="ResetWindowClick" Grid.Column="2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 语言设置卡片 -->
                <Border Style="{StaticResource CardStyleStretch}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Uid="Setting_Language_Title" Text="应用语言" FontSize="14"/>
                            <TextBlock x:Uid="Settings_Language_Description" Text="更改界面语言，重启后生效" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="2" Width="150" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                             <ComboBoxItem x:Uid="Lang_ZH_Hans" Tag="zh-Hans">简体中文</ComboBoxItem>
                            <ComboBoxItem x:Uid="Lang_ZH_Hant" Tag="zh-Hant">繁體中文</ComboBoxItem>
                            <ComboBoxItem x:Uid="Lang_EN" Tag="en">English</ComboBoxItem>
                             <ComboBoxItem x:Uid="Lang_JA" Tag="ja">日本語</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 数据导入卡片：用外部 ships_static.db 替换当前数据目录中的库 -->
                <Border Style="{StaticResource CardStyleStretch}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8DE;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Setting_Data_Title" Text="导入数据库" FontSize="14"/>
                                <TextBlock x:Uid="Setting_Data_Description" Text="选择一个 ships_static.db 文件，校验后替换当前数据目录中的数据库并立即重新加载"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Uid="Setting_Data_Button" x:Name="ImportDatabaseButton" Content="选择数据库文件…" Click="ImportDatabaseButton_Click" Grid.Column="2"/>
                        </Grid>
                    </StackPanel>
                </Border>
            
                <!-- 日志记录卡片 -->
                <Button Style="{StaticResource CardButtonStyle}" Click="NavigateToLogPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Uid="Setting_Log_Title" Text="日志记录" FontSize="14"/>
                            <TextBlock x:Uid="Setting_Log_Description" Text="查看和管理操作日志" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE974;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                
                <!-- 更新卡片 -->
                <Button Style="{StaticResource CardButtonStyle}" Click="NavigateToUpdatePage">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xF0C5;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="Setting_Update_Title" Text="更新" FontSize="14"/>
                                <TextBlock x:Uid="Setting_Update_Description" Text="调整应用更新配置与更新源" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE974;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Button>

                <!-- 头像管理卡片已迁移至「更新」页（UpdatePage） -->

                <!-- 关于卡片（使用 Expander 可折叠） -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">

                    <Expander x:Uid="Setting_About_Header" x:Name="AboutExpander" Header="关于" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,0,0,12" MinHeight="64">
                        <StackPanel Padding="20,0,0,0">
                            <TextBlock x:Name="VersionTextBlock" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="Setting_About_1" Text="开发者：菲梦林光" Margin="0,0,0,0"/>
                            <TextBlock x:Uid="Setting_About_2" Text="开源协议：GPL-3.0、CC BY-NC-SA 4.0" Margin="0,0,0,0"/>
                            <HyperlinkButton x:Uid="Setting_About_3" Margin="0,5,0,0" Content="项目主页" NavigateUri="https://github.com/xiwangzaiqianfang/AzurLaneDex"/>
                            <HyperlinkButton x:Uid="Setting_About_4" Margin="0,5,0,0" Content="Wiki主页" NavigateUri="https://wiki.biligame.com/blhx/首页"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
