<UserControl x:Class="AzurLaneDex.Views.Controls.AcquireEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid ColumnSpacing="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="140"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
        <ComboBox x:Name="TagComboBox" Grid.Column="0" 
                  DisplayMemberPath="DisplayName" 
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding Tag, Mode=TwoWay}"
                  SelectionChanged="OnTagChanged"/>
        <StackPanel x:Name="ParamsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4"/>
        <TextBox x:Name="CustomTextTextBox" 
                 AcceptsReturn="True" 
                 Grid.Column="1" 
                 Visibility="Collapsed" 
                 PlaceholderText="自定义文本 (多语言)" 
                 TextWrapping="Wrap" 
                 Height="60" 
                 Width="300"/>
        <Button x:Name="DeleteButton" Grid.Column="2"
                Width="40" Height="32"
                ToolTipService.ToolTip="删除"
                Click="OnDeleteClick">
            <FontIcon Glyph="&#xE74D;" FontSize="14" />
        </Button>
    </Grid>
</UserControl>