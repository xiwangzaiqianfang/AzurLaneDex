<Page x:Class="AzurLaneDex.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:AzurLaneDex.Converters"
      xmlns:views="using:AzurLaneDex.Views">

    <Page.Resources>
        <converters:BoolToCheckMarkConverter x:Key="BoolToCheckMark"/>
        <converters:BoolToBreakthroughTextConverter x:Key="BoolToBreakthroughText"/>
        <converters:BoolToHeartConverter x:Key="BoolToHeart"/>
        <converters:BoolToStarConverter x:Key="BoolToStar"/>

        <!-- 完整模板：显示所有列 -->
        <DataTemplate x:Key="FullTemplate">
            <Grid>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="ContextMenuOwned" Text="标记为已获得" Click="ContextMenu_Owned_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotOwned" Text="标记为未获得" Click="ContextMenu_NotOwned_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuMaxBreak" Text="标记为已满破" Click="ContextMenu_MaxBreak_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotMaxBreak" Text="标记为未满破" Click="ContextMenu_NotMaxBreak_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuLevel120" Text="标记为已120级" Click="ContextMenu_Level120_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotLevel120" Text="标记为未120级" Click="ContextMenu_NotLevel120_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuOath" Text="标记为已誓约" Click="ContextMenu_Oath_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotOath" Text="标记为未誓约" Click="ContextMenu_NotOath_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuRemodeled" Text="标记为已改造" Click="ContextMenu_Remodeled_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotRemodeled" Text="标记为未改造" Click="ContextMenu_NotRemodeled_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuSpecialGear" Text="标记为已拥有特殊兵装" Click="ContextMenu_SpecialGear_Click"/>
                        <MenuFlyoutItem x:Name="ContextMenuNotSpecialGear" Text="标记为未拥有特殊兵装" Click="ContextMenu_NotSpecialGear_Click"/>
                        <MenuFlyoutSeparator x:Name="SeparatorDelete"/>
                        <MenuFlyoutItem x:Uid="DeleteShipButton" x:Name="ContextMenuDelete" Text="删除舰船" Click="ContextMenu_Delete_Click" Foreground="Red"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayId}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Owned, Converter={StaticResource BoolToCheckMark}}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Oath, Converter={StaticResource BoolToHeart}}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding BreakthroughDisplay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding Level120, Converter={StaticResource BoolToStar}}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" Text="{Binding Remodeled, Converter={StaticResource BoolToCheckMark}}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="{Binding SpecialGearObtained, Converter={StaticResource BoolToCheckMark}}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 紧凑模板：隐藏突破、120级、兵装 -->
        <DataTemplate x:Key="CompactTemplate">
            <Grid>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="标记为已获得" Click="ContextMenu_Owned_Click"/>
                        <MenuFlyoutItem Text="标记为未获得" Click="ContextMenu_NotOwned_Click"/>
                        <MenuFlyoutItem Text="标记为已满破" Click="ContextMenu_MaxBreak_Click"/>
                        <MenuFlyoutItem Text="标记为未满破" Click="ContextMenu_NotMaxBreak_Click"/>
                        <MenuFlyoutItem Text="标记为已120级" Click="ContextMenu_Level120_Click"/>
                        <MenuFlyoutItem Text="标记为未120级" Click="ContextMenu_NotLevel120_Click"/>
                        <MenuFlyoutItem Text="标记为已誓约" Click="ContextMenu_Oath_Click"/>
                        <MenuFlyoutItem Text="标记为未誓约" Click="ContextMenu_NotOath_Click"/>
                        <MenuFlyoutItem Text="标记为已改造" Click="ContextMenu_Remodeled_Click"/>
                        <MenuFlyoutItem Text="标记为未改造" Click="ContextMenu_NotRemodeled_Click"/>
                        <MenuFlyoutItem Text="标记为已拥有特殊兵装" Click="ContextMenu_SpecialGear_Click"/>
                        <MenuFlyoutItem Text="标记为未拥有特殊兵装" Click="ContextMenu_NotSpecialGear_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="DeleteShipButton" Text="删除舰船" Click="ContextMenu_Delete_Click" Foreground="Red"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayId}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Owned, Converter={StaticResource BoolToCheckMark}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Oath, Converter={StaticResource BoolToHeart}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding Remodeled, Converter={StaticResource BoolToCheckMark}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 极简模板：仅复选框、编号、名称 -->
        <DataTemplate x:Key="MinimalTemplate">
            <Grid>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="标记为已获得" Click="ContextMenu_Owned_Click"/>
                        <MenuFlyoutItem Text="标记为未获得" Click="ContextMenu_NotOwned_Click"/>
                        <MenuFlyoutItem Text="标记为已满破" Click="ContextMenu_MaxBreak_Click"/>
                        <MenuFlyoutItem Text="标记为未满破" Click="ContextMenu_NotMaxBreak_Click"/>
                        <MenuFlyoutItem Text="标记为已120级" Click="ContextMenu_Level120_Click"/>
                        <MenuFlyoutItem Text="标记为未120级" Click="ContextMenu_NotLevel120_Click"/>
                        <MenuFlyoutItem Text="标记为已誓约" Click="ContextMenu_Oath_Click"/>
                        <MenuFlyoutItem Text="标记为未誓约" Click="ContextMenu_NotOath_Click"/>
                        <MenuFlyoutItem Text="标记为已改造" Click="ContextMenu_Remodeled_Click"/>
                        <MenuFlyoutItem Text="标记为未改造" Click="ContextMenu_NotRemodeled_Click"/>
                        <MenuFlyoutItem Text="标记为已拥有特殊兵装" Click="ContextMenu_SpecialGear_Click"/>
                        <MenuFlyoutItem Text="标记为未拥有特殊兵装" Click="ContextMenu_NotSpecialGear_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Uid="DeleteShipButton" Text="删除舰船" Click="ContextMenu_Delete_Click" Foreground="Red"/>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayId}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== InfoBar 容器 ===== -->
        <StackPanel Grid.Row="0" Margin="12,12,12,-6" Spacing="8">
            <InfoBar x:Name="BetaInfoBar"
                     x:Uid="BetaInfoBar"
                     Title="测试版本"
                     Message="当前为预览版，请留意潜在的 bug，并在发现问题时向我们反馈。"
                     Severity="Warning"
                     IsOpen="True"
                     IsClosable="True">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Uid="BetaInfoBarLink" Content="前往反馈" NavigateUri="https://github.com/xiwangzaiqianfang/AzurLaneDex/issues"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="AnniversaryInfoBar"
                     x:Uid="AnniversaryInfoBar"
                     Title="🎉祝《碧蓝航线》九周年生日快乐！🎉"
                     IsOpen="True"
                     IsClosable="True">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Uid="AnniversaryInfoBarLink" Content="前往官方活动页面查看活动详情" NavigateUri="https://game.bilibili.com/blhx/2026-ninth-anniversary/h5/"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- 分类选择器（SelectorBar）单独一行 -->
        <SelectorBar x:Name="CategorySelector" Grid.Row="1" Margin="12,-6,12,0"
                     SelectionChanged="CategorySelector_SelectionChanged">
            <SelectorBarItem x:Uid="CategoryTag_Normal" Text="角色" Tag="Normal" />
            <SelectorBarItem x:Uid="CategoryTag_Collab" Text="联动" Tag="Collab" />
            <SelectorBarItem x:Uid="CategoryTag_Research" Text="方案舰" Tag="Research" />
            <SelectorBarItem x:Uid="CategoryTag_META" Text="META" Tag="META" />
        </SelectorBar>

        <!-- CommandBar 功能区 -->
        <CommandBar Grid.Row="2" Margin="12,4,12,4" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="SearchBox"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="搜索舰船名"
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"
                                    SuggestionChosen="SearchBox_SuggestionChosen"
                                    UpdateTextOnSelect="True"
                                    VerticalAlignment="Center"
                                    Width="150"
                                    Margin="6,7,0,0">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DisplayText}"/>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ComboBox x:Name="SortCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged" VerticalAlignment="Center" MinWidth="120" Margin="6,8,8,0">
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item0">按编号排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item1">按图鉴排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item2">按名称排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item3">按稀有度排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item4">按改造日期排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item5">按兵装日期排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item6">按获得状态排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item7">按改造状态排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item8">按突破状态排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item9">按誓约状态排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item10">按120级状态排序</ComboBoxItem>
                        <ComboBoxItem x:Uid="MainPage_SortCombo_Item11">按兵装获得状态排序</ComboBoxItem>
                    </ComboBox>
                    <ToggleButton x:Uid="MainPage_SortToggle" x:Name="SortOrderToggle" Grid.Column="2" Content="升序" Margin="0,8,8,0"
                                  Checked="SortOrderToggle_Checked" Unchecked="SortOrderToggle_Unchecked" VerticalAlignment="Center"/>
                </Grid>
            </CommandBar.Content>

            <!-- 主要命令 -->
            <AppBarButton Icon="Filter" Label="筛选" x:Uid="FilterButton" Click="FilterButton_Click" VerticalAlignment="Center"/>
            <AppBarButton x:Name="BatchOperationButton" x:Uid="BatchOperationButton" Icon="SelectAll" Label="批量操作" Click="BatchOperation_Click" VerticalAlignment="Center"/>
            <AppBarButton x:Name="AddShipButton" Icon="Add" x:Uid="AddShipButton" Label="新建舰船" Click="AddShipButton_Click" Visibility="Collapsed" VerticalAlignment="Center"/>

            <!-- 辅助命令 -->
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="ResetAndRefreshButton" Label="重置并刷新" Click="ResetAndRefresh_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- 主体区域：左右两列 + GridSplitter -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="2*" MinWidth="370" MaxWidth="580"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧列表区域 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 完整表头 (9列) -->
                <Grid x:Name="FullHeader" Grid.Row="0" Height="32" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefault}" Margin="12,0,12,0" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0" Padding="0"
              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                    <TextBlock x:Uid="MainPage_Header_ID"  Grid.Column="1" Text="编号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Name" Grid.Column="2" Text="名称" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Owned" Grid.Column="3" Text="获得" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Oath" Grid.Column="4" Text="誓约" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Breakthrough" Grid.Column="5" Text="突破" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Level120" Grid.Column="6" Text="120级" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Remodel" Grid.Column="7" Text="改造" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_SpecialGear" Grid.Column="8" Text="兵装" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 紧凑表头 (7列) -->
                <Grid x:Name="CompactHeader" Grid.Row="0" Height="32" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefault}" Margin="12,0,12,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="CompactSelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0" Padding="0"
              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                    <TextBlock x:Uid="MainPage_Header_ID"  Grid.Column="1" Text="编号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Name" Grid.Column="2" Text="名称" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Owned" Grid.Column="3" Text="获得" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Oath" Grid.Column="4" Text="誓约" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Remodel" Grid.Column="5" Text="改造" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 极简表头 (3列) -->
                <Grid x:Name="MinimalHeader" Grid.Row="0" Height="32" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefault}" Margin="12,0,12,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="MinimalSelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" Margin="16,0,0,0" Padding="0"
              Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                    <TextBlock x:Uid="MainPage_Header_ID"  Grid.Column="1" Text="编号" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Uid="MainPage_Header_Name" Grid.Column="2" Text="名称" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 舰船列表 -->
                <ListView x:Name="ShipListView" Grid.Row="1" 
                          SelectionMode="Single" 
                          SelectionChanged="ShipListView_SelectionChanged"
                          RightTapped="ShipListView_RightTapped"
                          Margin="12,0,12,0"
                          ItemTemplate="{StaticResource FullTemplate}"/>
            </Grid>

            <!-- 右侧详情区域 -->
            <views:ShipDetailControl x:Name="ShipDetailControl" Grid.Column="2" Margin="12,0,12,0"/>
        </Grid>
    </Grid>
</Page>