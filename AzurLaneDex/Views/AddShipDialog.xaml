<ContentDialog x:Class="AzurLaneDex.Views.AddShipDialog"
               x:Name="DialogRoot"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:Microsoft.UI.Xaml.Controls"
               xmlns:models="using:AzurLaneDex.Models"
               xmlns:selectors="using:AzurLaneDex.Selectors"
               xmlns:converters="using:AzurLaneDex.Converters"
               Title="编辑舰船"
               PrimaryButtonText="保存"
               CloseButtonText="取消"
               DefaultButton="Primary"
               PrimaryButtonClick="OnPrimaryButtonClick"
               Loaded="OnLoaded1"
               Width="800"
               MaxHeight="10000">

    <ContentDialog.Resources>
        <!-- 各类型编辑模板 -->
        <DataTemplate x:Key="ConstructionTemplate">
            <StackPanel Margin="0,8,0,0">
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_TypeCombobox"
                          Header="获取方式类型" 
                          ItemsSource="{Binding ElementName=DialogRoot, Path=TypeOptions}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_DeleteButton" Content="✕ 删除" Background="Transparent" BorderThickness="0" Click="RemoveMethod_Click" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,-45,0,0"/>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_MainCheckbox" Content="主要获取方式" IsChecked="{Binding IsPrimary}" Checked="OnPrimaryCheckChanged" Unchecked="OnPrimaryCheckChanged" HorizontalAlignment="Right" Margin="0,-45,80,0"/>
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_Build_PoolCombobox" Header="建造池" ItemsSource="{Binding ElementName=DialogRoot, Path=PoolOptions}" SelectedItem="{Binding Pool}" MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnSpacing="8" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox Grid.Column="0" x:Uid="AddShipDialog_AcquisitionMethod_Build_CubeNumberbox" Header="魔方" Value="{Binding CostCube}" Minimum="0" SpinButtonPlacementMode="Inline"/>
                    <NumberBox Grid.Column="1" x:Uid="AddShipDialog_AcquisitionMethod_Build_GoldNumberbox" Header="金币" Value="{Binding CostGold}" Minimum="0" SpinButtonPlacementMode="Inline"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                    <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Build_TimeHourNumberbox" Header="时长" Value="{Binding BuildHour}" Minimum="0" Maximum="23" Width="100" SpinButtonPlacementMode="Inline" PlaceholderText="时"/>
                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="20" Margin="0,20,0,0"/>
                    <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Build_TimeMinuteNumberbox" Header=" " Value="{Binding BuildMinute}" Minimum="0" Maximum="59" Width="100" SpinButtonPlacementMode="Inline" PlaceholderText="分"/>
                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="20" Margin="0,20,0,0"/>
                    <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Build_TimeSecondsNumberbox" Header=" " Value="{Binding BuildSecond}" Minimum="0" Maximum="59" Width="100" SpinButtonPlacementMode="Inline" PlaceholderText="秒"/>
                </StackPanel>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_Build_LimitedCheckbox" Content="限时" IsChecked="{Binding IsLimited}" Margin="0,0,0,8"/>
                <TextBox x:Uid="AddShipDialog_AcquisitionMethod_Build_EventTextbox" Header="关联活动ID" Text="{Binding EventId}" PlaceholderText="（可选）" Margin="0,0,0,8"/>
                <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Build_ProbabilityNumberbox" Header="概率（%）" Value="{Binding Probability}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Margin="0,0,0,8"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DropTemplate">
            <StackPanel Margin="0,8,0,0">
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_TypeCombobox"
                          Header="获取方式类型" 
                          ItemsSource="{Binding ElementName=DialogRoot, Path=TypeOptions}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_DeleteButton" Content="✕ 删除" Background="Transparent" BorderThickness="0" Click="RemoveMethod_Click" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,-45,0,0"/>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_MainCheckbox" Content="主要获取方式" IsChecked="{Binding IsPrimary}" Checked="OnPrimaryCheckChanged" Unchecked="OnPrimaryCheckChanged" HorizontalAlignment="Right" Margin="0,-45,80,0"/>
                <TextBlock x:Uid="AddShipDialog_AcquisitionMethod_Drop_Textblock" Text="掉落地点列表" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Locations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Row="0" Grid.Column="0" x:Uid="AddShipDialog_AcquisitionMethod_Drop_MapIDTextbox" Text="{Binding Map}" PlaceholderText="关卡编号" Margin="0,0,0,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" x:Uid="AddShipDialog_AcquisitionMethod_Drop_BossCheckbox" Content="Boss" IsChecked="{Binding IsBoss}" Margin="0,0,0,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Uid="AddShipDialog_AcquisitionMethod_Drop_EliteCheckbox" Content="精英" IsChecked="{Binding IsElite}" Margin="0,0,0,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" x:Uid="AddShipDialog_AcquisitionMethod_Drop_ArchiveCheckbox" Content="档案" IsChecked="{Binding IsWarArchives}" Margin="0,0,0,8"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveDropLocation_Click" Tag="{Binding}"  Margin="0,0,0,8"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_Drop_AddButton" Content="+ 添加掉落点" Click="AddDropLocation_Click"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ExchangeTemplate">
            <StackPanel Margin="0,8,0,0">
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_TypeCombobox"
                          Header="获取方式类型" 
                          ItemsSource="{Binding ElementName=DialogRoot, Path=TypeOptions}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_DeleteButton" Content="✕ 删除" Background="Transparent" BorderThickness="0" Click="RemoveMethod_Click" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,-45,0,0"/>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_MainCheckbox" Content="主要获取方式" IsChecked="{Binding IsPrimary}" Checked="OnPrimaryCheckChanged" Unchecked="OnPrimaryCheckChanged" HorizontalAlignment="Right" Margin="0,-45,80,0"/>
                <TextBlock x:Uid="AddShipDialog_AcquisitionMethod_Shop_Textblock" Text="兑换商店列表" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Shops}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 商店下拉框 -->
                                <ComboBox Grid.Row="0" Grid.Column="0" 
                                          Header="商店类型"
                                          ItemsSource="{Binding ElementName=DialogRoot, Path=ShopOptions}"
                                          SelectedItem="{Binding Shop, Mode=TwoWay}" MinWidth="100">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 自定义商店名称（仅当 Shop == Custom 时显示） -->
                                <TextBox Grid.Row="0" Grid.Column="2" 
                                         x:Uid="AddShipDialog_AcquisitionMethod_Shop_NameTextbox"
                                         Header="商店名称"
                                         Text="{Binding CustomShopNameString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="多语言，|分隔"
                                         Visibility="{Binding Shop, Converter={StaticResource EnumToVisibility}, ConverterParameter=Custom}"/>

                                <!-- 货币名称（多语言） -->
                                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                         x:Uid="AddShipDialog_AcquisitionMethod_Shop_CostNameTextbox"
                                         Header="货币名称" Margin="0,8,0,0"
                                         Text="{Binding CurrencyString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="多语言，|分隔"/>

                                <!-- 成本 -->
                                <NumberBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" x:Uid="AddShipDialog_AcquisitionMethod_Shop_CostNumberbox" Header="数量" Value="{Binding Cost}" Minimum="0" SpinButtonPlacementMode="Inline"/>

                                <!-- 删除按钮 -->
                                <Button Grid.Row="0" Grid.Column="3" Content="✕" Background="Transparent" BorderThickness="0"
                                        Click="RemoveExchangeEntry_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_Shop_AddButton" Content="+ 添加兑换项" Click="AddExchangeEntry_Click" Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResearchTemplate">
            <StackPanel Margin="0,8,0,0">
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_TypeCombobox"
                          Header="获取方式类型" 
                          ItemsSource="{Binding ElementName=DialogRoot, Path=TypeOptions}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_DeleteButton" Content="✕ 删除" Background="Transparent" BorderThickness="0" Click="RemoveMethod_Click" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,-45,0,0"/>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_MainCheckbox" Content="主要获取方式" IsChecked="{Binding IsPrimary}" Checked="OnPrimaryCheckChanged" Unchecked="OnPrimaryCheckChanged" HorizontalAlignment="Right" Margin="0,-45,80,0"/>
                <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Research_SeriesNumberbox" Header="科研期数" Value="{Binding Series}" Minimum="1" SpinButtonPlacementMode="Inline" Margin="0,0,0,8"/>
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_Research_RarityCheckbox" Header="稀有度类型" SelectedValue="{Binding ResearchRarity}" SelectedValuePath="Tag" MinWidth="120" Margin="0,0,0,8">
                    <ComboBoxItem x:Uid="AddShipDialog_AcquisitionMethod_Research_RarityComboboxItem_Tag_SSR" Content="方案舰" Tag="priority"/>
                    <ComboBoxItem x:Uid="AddShipDialog_AcquisitionMethod_Research_RarityComboboxItem_Tag_UR" Content="决战方案" Tag="decisive"/>
                </ComboBox>
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_Research_FactionCombobox" Header="阵营" ItemsSource="{Binding ElementName=DialogRoot, Path=FactionOptions}" 
                          SelectedItem="{Binding ResearchFaction}" MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}" Margin="0,0,0,8"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <NumberBox x:Uid="AddShipDialog_AcquisitionMethod_Research_PointsNumberbox" Header="科技点数需求" Value="{Binding TechPoints}" Minimum="0" SpinButtonPlacementMode="Inline" Margin="0,0,0,8"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OtherTemplate">
            <StackPanel Margin="0,8,0,0">
                <ComboBox x:Uid="AddShipDialog_AcquisitionMethod_TypeCombobox"
                          Header="获取方式类型" 
                          ItemsSource="{Binding ElementName=DialogRoot, Path=TypeOptions}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"
                          MinWidth="120" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayString}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="AddShipDialog_AcquisitionMethod_DeleteButton" Content="✕ 删除" Background="Transparent" BorderThickness="0" Click="RemoveMethod_Click" Tag="{Binding}" HorizontalAlignment="Right" Margin="0,-45,0,0"/>
                <CheckBox x:Uid="AddShipDialog_AcquisitionMethod_MainCheckbox" Content="主要获取方式" IsChecked="{Binding IsPrimary}" Checked="OnPrimaryCheckChanged" Unchecked="OnPrimaryCheckChanged" HorizontalAlignment="Right" Margin="0,-45,80,0"/>
                <TextBox x:Uid="AddShipDialog_AcquisitionMethod_Other_NameTextbox" Header="方法名称" Text="{Binding MethodNameString, Mode=TwoWay}" PlaceholderText="多语言，|分隔。如：勋章支援|Medal Support" Margin="0,0,0,8"/>
            </StackPanel>
        </DataTemplate>

        <converters:EnumToDisplayStringConverter x:Key="EnumToDisplayString"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <selectors:AcquisitionMethodEditTemplateSelector x:Key="MethodEditSelector"
            ConstructionTemplate="{StaticResource ConstructionTemplate}"
            DropTemplate="{StaticResource DropTemplate}"
            ExchangeTemplate="{StaticResource ExchangeTemplate}"
            ResearchTemplate="{StaticResource ResearchTemplate}"
            OtherTemplate="{StaticResource OtherTemplate}" />
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="8">

            <!-- ============ 基本信息 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0" MinWidth="400">
                <Expander IsExpanded="True" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="20,10" MinHeight="50">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="AddShipDialog_BasicInfo_ExpanderHeaderTextBlock" Text="基本信息" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_IDTextBlcok" Text="编号:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                            <!-- Row 1: 图鉴顺序 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_GameOrderTextBlock" Text="图鉴顺序:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="GameOrderBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                            <!-- Row 2: 全局名称 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_GlobalNameTextBlock" Text="全局名称:" VerticalAlignment="Center"/>
                            <TextBox x:Name="GlobalNameBox" Grid.Row="2" Grid.Column="1"/>

                            <!-- Row 3: 名称 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_NameTextBlock" Text="名称:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBox x:Name="NameZhBox" x:Uid="AddShipDialog_BasicInfo_NameTextbox_ZhHans" Header="简体中文" PlaceholderText="简体中文名称"/>
                                <TextBox x:Name="NameZhHantBox" x:Uid="AddShipDialog_BasicInfo_NameTextbox_ZhHant" Header="繁體中文" PlaceholderText="繁體中文名稱" Margin="0,4,0,0"/>
                                <TextBox x:Name="NameEnBox" x:Uid="AddShipDialog_BasicInfo_NameTextbox_En" Header="English" PlaceholderText="English name" Margin="0,4,0,0"/>
                                <TextBox x:Name="NameJaBox" x:Uid="AddShipDialog_BasicInfo_NameTextbox_Ja" Header="日本語" PlaceholderText="日本語名" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Row 4: 和谐名 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_AltNameTextBlock" Text="和谐名:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox x:Name="AltNameBox" Grid.Row="4" Grid.Column="1" PlaceholderText="仅简体中文"/>

                            <!-- Row 5: 别名 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_AliasTextBlock" Text="别名:" VerticalAlignment="Center"/>
                            <TextBox x:Name="AliasBox" Grid.Row="5" Grid.Column="1"/>

                            <!-- Row 6: 舰级 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_ClassTextBlock" Text="舰级:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="6" Grid.Column="1">
                                <TextBox x:Name="ClassZhBox" x:Uid="AddShipDialog_BasicInfo_ClassTextbox_ZhHans" Header="简体中文" PlaceholderText="简体中文舰级"/>
                                <TextBox x:Name="ClassZhHantBox" x:Uid="AddShipDialog_BasicInfo_ClassTextbox_ZhHant" Header="繁體中文" PlaceholderText="繁體中文艦級" Margin="0,4,0,0"/>
                                <TextBox x:Name="ClassEnBox" x:Uid="AddShipDialog_BasicInfo_ClassTextbox_En" Header="English" PlaceholderText="English class" Margin="0,4,0,0"/>
                                <TextBox x:Name="ClassJaBox" x:Uid="AddShipDialog_BasicInfo_ClassTextbox_Ja" Header="日本語" PlaceholderText="日本語クラス" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Row 7: 分类 -->
                            <TextBlock Grid.Row="7" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_CategoryTextBlock" Text="分类:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CategoryCombo" Grid.Row="7" Grid.Column="1" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged">
                                <ComboBoxItem x:Uid="AddShipDialog_BasicInfo_CategoryCombobox_Tag_Normal" Content="普通" Tag="Normal"/>
                                <ComboBoxItem x:Uid="AddShipDialog_BasicInfo_CategoryCombobox_Tag_Collab" Content="联动" Tag="Collab"/>
                                <ComboBoxItem x:Uid="AddShipDialog_BasicInfo_CategoryCombobox_Tag_Research" Content="科研" Tag="Research"/>
                                <ComboBoxItem x:Uid="AddShipDialog_BasicInfo_CategoryCombobox_Tag_META" Content="META" Tag="META"/>
                            </ComboBox>

                            <!-- Row 8: 舰种 -->
                            <TextBlock Grid.Row="8" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_ShipTypeTextBlock" Text="舰种:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ShipTypeCombo" Grid.Row="8" Grid.Column="1">
                            </ComboBox>

                            <!-- Row 9: 稀有度 -->
                            <TextBlock Grid.Row="9" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_RarityTextBlock" Text="稀有度:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="RarityCombo" Grid.Row="9" Grid.Column="1">
                            </ComboBox>

                            <!-- Row 10: 阵营 -->
                            <TextBlock Grid.Row="10" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_FactionTextBlock" Text="阵营:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FactionCombo" Grid.Row="10" Grid.Column="1">
                            </ComboBox>

                            <!-- Row 11: 实装日期 -->
                            <TextBlock Grid.Row="11" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_ReleaseDateTextBlock" Text="实装日期:" VerticalAlignment="Center"/>
                            <DatePicker x:Name="ReleaseDatePicker" Grid.Row="11" Grid.Column="1"/>

                            <CheckBox Grid.Row="12" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_RetrofitCheckBox" x:Name="CanRetrofitCheck" Content="可改造"/>
                            
                            <!-- Row 12: 改造日期 -->
                            <TextBlock Grid.Row="13" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_RetrofitDateTextBlock" Text="改造日期:" VerticalAlignment="Center"/>
                            <DatePicker x:Name="RetrofitDatePicker" Grid.Row="13" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=CanRetrofitCheck}"/>

                            <!-- Row 13: 相关活动 -->
                            <TextBlock Grid.Row="14" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_RelatedEventTextBlock" Text="相关活动:" VerticalAlignment="Center"/>
                            <TextBox x:Name="RelatedEventBox" Grid.Row="14" Grid.Column="1"/>

                            <!-- Row 14: 常驻 -->
                            <TextBlock Grid.Row="15" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_IsPermanentTextBlock" Text="常驻:" VerticalAlignment="Center"/>
                            <CheckBox x:Name="IsPermanentCheckBox" Grid.Row="15" Grid.Column="1" x:Uid="AddShipDialog_BasicInfo_IsPermanentCheckBox" Content="常驻" VerticalAlignment="Center"/>

                            <!-- Row 15: 声优 -->
                            <TextBlock Grid.Row="16" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_CvTextBlock" Text="声优:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="16" Grid.Column="1">
                                <TextBox x:Name="CvZhBox" x:Uid="AddShipDialog_BasicInfo_CvTextbox_ZhHans" Header="简体中文"/>
                                <TextBox x:Name="CvZhHantBox" x:Uid="AddShipDialog_BasicInfo_CvTextbox_ZhHant" Header="繁體中文" Margin="0,4,0,0"/>
                                <TextBox x:Name="CvEnBox" x:Uid="AddShipDialog_BasicInfo_CvTextbox_En" Header="English" Margin="0,4,0,0"/>
                                <TextBox x:Name="CvJaBox" x:Uid="AddShipDialog_BasicInfo_CvTextbox_Ja" Header="日本語" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Row 16: 画师 -->
                            <TextBlock Grid.Row="17" Grid.Column="0" x:Uid="AddShipDialog_BasicInfo_ArtistTextBlock" Text="画师:" VerticalAlignment="Center"/>
                            <TextBox x:Name="ArtistBox" Grid.Row="17" Grid.Column="1" Height="40"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 属性 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="AddShipDialog_Property_ExpanderHeaderTextBlock" Text="属性" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="AddShipDialog_Property_HPTextBlock" Grid.Row="0" Grid.Column="0" Text="耐久:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="HpBox" Grid.Row="0" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_ArmorTextBlock" Grid.Row="0" Grid.Column="3" Text="装甲:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ArmorCombo" Grid.Row="0" Grid.Column="4" SelectedIndex="0">
                            <ComboBoxItem x:Uid="AddShipDialog_Property_ArmorComboboxItem_Tag_Light" Content="轻甲" Tag="Light"/>
                            <ComboBoxItem x:Uid="AddShipDialog_Property_ArmorComboboxItem_Tag_Medium" Content="中甲" Tag="Medium"/>
                            <ComboBoxItem x:Uid="AddShipDialog_Property_ArmorComboboxItem_Tag_Heavy" Content="重甲" Tag="Heavy"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_FpTextBlock" Grid.Row="1" Grid.Column="0" Text="炮击:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="FpBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_TrpTextBlock" Grid.Row="1" Grid.Column="3" Text="雷击:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="TrpBox" Grid.Row="1" Grid.Column="4" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_AaTextBlock" Grid.Row="2" Grid.Column="0" Text="防空:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="AaBox" Grid.Row="2" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_AviTextBlock" Grid.Row="2" Grid.Column="3" Text="航空:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="AviBox" Grid.Row="2" Grid.Column="4" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_HitTextBlock" Grid.Row="3" Grid.Column="0" Text="命中:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="HitBox" Grid.Row="3" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_EvaTextBlock" Grid.Row="3" Grid.Column="3" Text="机动:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="EvaBox" Grid.Row="3" Grid.Column="4" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_AswTextBlock" Grid.Row="4" Grid.Column="0" Text="反潜:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="AswBox" Grid.Row="4" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_LuckTextBlock" Grid.Row="4" Grid.Column="3" Text="幸运:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="LuckBox" Grid.Row="4" Grid.Column="4" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_OilTextBlock" Grid.Row="5" Grid.Column="0" Text="油耗:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="OilBox" Grid.Row="5" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <TextBlock x:Uid="AddShipDialog_Property_SpeedTextBlock" Grid.Row="5" Grid.Column="3" Text="航速:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="SpeedBox" Grid.Row="5" Grid.Column="4" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>

                        <!-- 性能评级 -->
                        <TextBlock x:Uid="AddShipDialog_Property_HpGradeTextBlock" Grid.Row="6" Grid.Column="0" Text="HP评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="HpGradeCombo" Grid.Row="6" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_AaGradeTextBlock" Grid.Row="6" Grid.Column="3" Text="AA评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AaGradeCombo" Grid.Row="6" Grid.Column="4" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_EvaGradeTextBlock" Grid.Row="7" Grid.Column="0" Text="EVA评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="EvaGradeCombo" Grid.Row="7" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_AviGradeTextBlock" Grid.Row="7" Grid.Column="3" Text="AVI评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AviGradeCombo" Grid.Row="7" Grid.Column="4" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_TrpGradeTextBlock" Grid.Row="8" Grid.Column="0" Text="TRP评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TrpGradeCombo" Grid.Row="8" Grid.Column="1" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>

                        <TextBlock x:Uid="AddShipDialog_Property_FpGradeTextBlock" Grid.Row="8" Grid.Column="3" Text="FP评级:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FpGradeCombo" Grid.Row="8" Grid.Column="4" SelectedIndex="0">
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="S"/>
                        </ComboBox>
                    </Grid>
                </Expander>
            </Border>

            <!-- ============ 舰队科技 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA86;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="AddShipDialog_Tech_ExpanderHeaderTextBlock" Text="舰队科技" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="收集点数:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="CollectPointsBox" Grid.Row="0" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="满破点数:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="LimitBreakPointsBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="120级点数:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="Level120PointsBox" Grid.Row="2" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                    </Grid>
                </Expander>
            </Border>

            <!-- ============ 获取方式 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="获取方式" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <StackPanel>
                        <Button Content="+ 添加获取方式" Click="AddAcquisitionMethod_Click" HorizontalAlignment="Left" Margin="0,4"/>
                        <ItemsControl x:Name="AcquisitionMethodsItemsControl" 
                                      ItemTemplateSelector="{StaticResource MethodEditSelector}"/>
                    </StackPanel>
                </Expander>
            </Border>
            
            <!-- ============ 强化/退役 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="强化与退役" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,0" MinHeight="50">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="可作强化材料:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CanBeEnhanceMaterialCheck" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="强化价值:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="EnhanceValueBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="可退役:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CanRetireCheck" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="退役奖励:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RetirementRewardBox" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="强化经验:" VerticalAlignment="Top"/>
                        <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Row="0" Grid.Column="0" x:Name="EnhanceExpFp" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" Header="炮击"/>
                            <NumberBox Grid.Row="0" Grid.Column="1" x:Name="EnhanceExpTrp" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" Header="雷击"/>
                            <NumberBox Grid.Row="1" Grid.Column="0" x:Name="EnhanceExpAvi" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" Header="航空"/>
                            <NumberBox Grid.Row="1" Grid.Column="1" x:Name="EnhanceExpRld" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" Header="装填"/>
                        </Grid>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="强化道具:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox x:Name="EnhanceItemsBox" Grid.Row="5" Grid.Column="1" PlaceholderText="分号分隔" AcceptsReturn="True" Height="40" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="额外强化:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExtraEnhanceBox" Grid.Row="6" Grid.Column="1"/>
                    </Grid>
                </Expander>
            </Border>

            <!-- ============ 装备槽 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="装备槽" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,0,20,10" MinHeight="50">
                    <StackPanel>
                        <ItemsControl x:Name="EquipmentSlotsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="槽位" Grid.Column="0" Minimum="0" Value="{Binding SlotIndex}" SpinButtonPlacementMode="Inline" Margin="0,8,0,8"/>
                                            <TextBox Header="装备类型" Grid.Column="1" Text="{Binding EquipType}" PlaceholderText="装备类型" Margin="0,8,0,8"/>
                                            <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveEquipmentSlot_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加装备槽" Click="AddEquipmentSlot_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 初始装备 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="初始装备" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,0,20,10" MinHeight="50">
                    <StackPanel>
                        <ItemsControl x:Name="InitialEquipmentItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="槽位" Grid.Column="0" Minimum="0" Value="{Binding SlotIndex}" SpinButtonPlacementMode="Inline" Margin="0,8,0,8"/>
                                            <TextBox Grid.Column="1" Text="{Binding EquipmentId}" Header="装备ID" Margin="0,8,0,8"/>
                                            <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveInitialEquipment_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加初始装备" Click="AddInitialEquipment_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 技能 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="技能" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <StackPanel>
                        <ItemsControl x:Name="SkillsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Grid.Row="0" Grid.Column="0" Header="栏位" Minimum="0" Value="{Binding Id}" SpinButtonPlacementMode="Inline" Margin="0,8,0,8"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Header="技能名称" Text="{Binding NameString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="多语言用|分隔" Margin="0,8,0,8"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveSkill_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                            <TextBox Grid.Row="1" Grid.ColumnSpan="3" Header="技能描述" Text="{Binding DescriptionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="多语言用|分隔" AcceptsReturn="True" Margin="0,0,0,8"/>
                                            <TextBox Grid.Row="2" Grid.ColumnSpan="3" Header="各等级数值" Text="{Binding LevelValuesString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="每级一行" AcceptsReturn="True" Margin="0,0,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加技能" Click="AddSkill_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 改造 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="改造" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <StackPanel>
                        <CheckBox x:Name="ShipTypeChangedCheck" Content="改造后舰种变化" Margin="0,4,0,8" IsEnabled="{Binding IsChecked, ElementName=CanRetrofitCheck}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="改造后舰种:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TargetShipTypeCombo" Grid.Row="0" Grid.Column="1" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=CanRetrofitCheck}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="改造节点:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox x:Name="RetrofitNodesBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" Height="60" TextWrapping="Wrap" PlaceholderText="每个节点一行，格式: 名称|属性加成JSON|所需物品|金币|等级|星级" IsEnabled="{Binding IsChecked, ElementName=CanRetrofitCheck}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 科研 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="科研" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <StackPanel>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="前置阵营:" VerticalAlignment="Center"/>
                            <TextBox x:Name="PreReqFactionsBox" Grid.Row="0" Grid.Column="1" PlaceholderText="分号分隔"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="科技点数:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="TechPointsBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="任务列表:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox x:Name="ResearchTasksBox" Grid.Row="2" Grid.Column="1" PlaceholderText="每行一个" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="蓝图需求:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="BlueprintRequiredBox" Grid.Row="3" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="开发奖励:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox x:Name="DevelopBonusBox" Grid.Row="4" Grid.Column="1" PlaceholderText="每行 key=value" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="开发蓝图需求:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="DevelopBlueprintRequiredBox" Grid.Row="5" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                            <CheckBox x:Name="HasFateSimCheck" Grid.Row="6" Grid.ColumnSpan="2" Content="有天运拟合" Margin="0,8"/>
                            <ContentControl Grid.Row="7" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=HasFateSimCheck}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="天运等级:" VerticalAlignment="Center"/>
                                    <NumberBox x:Name="FateLevelBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="描述:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FateDescBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="蓝图需求:" VerticalAlignment="Center"/>
                                    <NumberBox x:Name="FateBlueprintRequiredBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 专属兵装 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="专属兵装" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <StackPanel>
                        <CheckBox x:Name="HasSpecialGearCheck" Content="可拥有专属兵装" Margin="0,0,0,8"/>
                        <ContentControl IsEnabled="{Binding IsChecked, ElementName=HasSpecialGearCheck}">
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="兵装名称:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBox x:Name="GearNameZhBox" Header="简体中文"/>
                                    <TextBox x:Name="GearNameZhHantBox" Header="繁體中文" Margin="0,4,0,0"/>
                                    <TextBox x:Name="GearNameEnBox" Header="English" Margin="0,4,0,0"/>
                                    <TextBox x:Name="GearNameJaBox" Header="日本語" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="实装日期:" VerticalAlignment="Center"/>
                                <DatePicker x:Name="GearDatePicker" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ID:" VerticalAlignment="Center"/>
                                <NumberBox x:Name="GearIdBox" Grid.Row="2" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="获取方式:" VerticalAlignment="Center"/>
                                <TextBox x:Name="GearAcquireBox" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 皮肤 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="皮肤" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,0,20,10" MinHeight="50">
                    <StackPanel>
                        <ItemsControl x:Name="SkinsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Header="皮肤名称" Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="多语言用|分隔" Margin="0,8,0,8"/>
                                            <NumberBox Grid.Column="1" Header="头像调用ID" Minimum="0" Value="{Binding Id}" SpinButtonPlacementMode="Inline" PlaceholderText="编号" Margin="0,8,0,8"/>
                                            <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveSkin_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加皮肤" Click="AddSkin_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 台词 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,0,20,10" MinHeight="50">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB78;"/>
                            <TextBlock x:Uid="AddShipDialog_Lines_ExpanderTitle" Text="台词" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <ItemsControl x:Name="LinesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" x:Uid="AddShipDialog_Lines_TypeCombobox" Header="台词类型" SelectedValue="{Binding Name, Mode=TwoWay}" PlaceholderText="类型" Margin="0,8,0,8">
                                                <ComboBoxItem Content="获得"/>
                                                <ComboBoxItem Content="登录"/>
                                                <ComboBoxItem Content="查看详情"/>
                                                <ComboBoxItem Content="主界面"/>
                                                <ComboBoxItem Content="触摸"/>
                                                <ComboBoxItem Content="特殊触摸"/>
                                                <ComboBoxItem Content="摸头"/>
                                                <ComboBoxItem Content="回港"/>
                                                <ComboBoxItem Content="旗舰开战"/>
                                                <ComboBoxItem Content="胜利"/>
                                                <ComboBoxItem Content="失败"/>
                                                <ComboBoxItem Content="MVP"/>
                                                <ComboBoxItem Content="技能"/>
                                                <ComboBoxItem Content="HP告急"/>
                                                <ComboBoxItem Content="强化成功"/>
                                                <ComboBoxItem Content="任务提醒"/>
                                                <ComboBoxItem Content="任务完成"/>
                                                <ComboBoxItem Content="邮件提醒"/>
                                                <ComboBoxItem Content="委托完成"/>
                                                <ComboBoxItem Content="好感度-失望"/>
                                                <ComboBoxItem Content="好感度-陌生"/>
                                                <ComboBoxItem Content="好感度-友好"/>
                                                <ComboBoxItem Content="好感度-喜欢"/>
                                                <ComboBoxItem Content="好感度-爱"/>
                                                <ComboBoxItem Content="誓约"/>
                                                <ComboBoxItem Content="礼物"/>
                                                <ComboBoxItem Content="皮肤描述"/>
                                                <ComboBoxItem Content="彩蛋"/>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" x:Uid="AddShipDialog_Lines_ContentTextbox" Header="台词内容" Text="{Binding ContentText, Mode=TwoWay}" PlaceholderText="台词内容 (多语言用|分隔)" Margin="0,8,0,8"/>
                                            <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveLine_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Uid="AddShipDialog_Lines_AddButton" Content="+ 添加台词" Click="AddLine_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 礼物偏好 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="礼物偏好" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,0,20,10" MinHeight="50">
                    <StackPanel>
                        <ItemsControl x:Name="GiftPreferencesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding GiftId}" Header="礼物ID" Margin="0,8,0,8"/>
                                            <ComboBox Grid.Column="1" Header="偏好" SelectedValue="{Binding Preference}" MinWidth="80" Margin="0,8,0,8">
                                                <ComboBoxItem Content="喜欢" Tag="Like"/>
                                                <ComboBoxItem Content="普通" Tag="Normal"/>
                                                <ComboBoxItem Content="厌恶" Tag="Dislike"/>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0" Click="RemoveGiftPreference_Click" Tag="{Binding}" Margin="0,34,0,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ 添加礼物偏好" Click="AddGiftPreference_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ============ 备注与引用 ============ -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="0">
                <Expander Header="备注与引用" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,10,20,10" MinHeight="50">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="备注:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox x:Name="RemarksBox" Grid.Row="0" Grid.Column="1" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="注释:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="相关资料:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReferenceMarkdownBox" Grid.Row="2" Grid.Column="1"/>
                    </Grid>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>