<ContentDialog x:Class="AzurLaneDex.Views.AddShipDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:Microsoft.UI.Xaml.Controls"
               xmlns:local="using:AzurLaneDex.Views.Controls"
               x:Uid="AddShipDialog"
               Title="新增舰船"
               PrimaryButtonText="添加"
               CloseButtonText="取消"
               DefaultButton="Primary"
               PrimaryButtonClick="OnPrimaryButtonClick"
               Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="550">
        <StackPanel Margin="12" Spacing="12">

            <!-- 基本信息卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="BasicInfo_Header" Text="基本信息" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="BasicInfo_Id" Text="编号:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Inline" Value="0" x:Uid="BasicInfo.AutoIdHint" PlaceholderText="0 表示自动分配"/>

                        <TextBlock x:Name="GameOrderLabel" x:Uid="BasicInfo_GameOrder" Grid.Row="1" Grid.Column="0" Text="图鉴顺序:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="GameOrderBox" Grid.Row="1" Grid.Column="1" Minimum="0" SpinButtonPlacementMode="Inline" Value="0"/>

                        <TextBlock x:Name="CategoryOrderLabel" x:Uid="BasicInfo_CategoryOrder"  Grid.Row="1" Grid.Column="0" Text="类别内顺序:" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <NumberBox x:Name="CategoryOrderBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" Visibility="Collapsed"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="BasicInfo_Name" Text="舰船名称:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBox x:Name="NameZhBox" Header="简体中文" PlaceholderText="简体中文名称"/>
                            <TextBox x:Name="NameZhHantBox" Header="繁體中文" PlaceholderText="繁體中文名稱" Margin="0,8,0,0"/>
                            <TextBox x:Name="NameEnBox" Header="English" PlaceholderText="English name" Margin="0,8,0,0"/>
                            <TextBox x:Name="NameJaBox" Header="日本語" PlaceholderText="日本語名" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="BasicInfo_AltName" Text="和谐名:" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="AltNameZhBox" Header="简体中文" PlaceholderText="简体中文和谐名"/>
                            <TextBox x:Name="AltNameZhHantBox" Header="繁體中文" PlaceholderText="繁體中文和諧名" Margin="0,8,0,0"/>
                            <TextBox x:Name="AltNameEnBox" Header="English" PlaceholderText="English censored name" Margin="0,8,0,0"/>
                            <TextBox x:Name="AltNameJaBox" Header="日本語" PlaceholderText="日本語和諧名" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" x:Uid="BasicInfo_Faction" Text="阵营:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FactionCombo" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" x:Uid="BasicInfo_ShipClass" Text="舰种:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ShipClassCombo" SelectionChanged="ShipClassCombo_SelectionChanged" Grid.Row="5" Grid.Column="1">
                            <ComboBoxItem x:Uid="ShipClass_DD">驱逐</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_CL">轻巡</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_CA">重巡</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_CB">超巡</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_BM">重炮</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_BC">战巡</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_BB">战列</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_BBV">航战</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_CV">航母</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_CVL">轻航</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_AR">维修</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_SS">潜艇</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_SSV">潜母</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_AE">运输</ComboBoxItem>
                            <ComboBoxItem x:Uid="ShipClass_Sail">风帆</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" x:Uid="BasicInfo_Rarity" Text="稀有度:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="RarityCombo" Grid.Row="6" Grid.Column="1">
                            <ComboBoxItem x:Uid="Rarity_N">普通</ComboBoxItem>
                            <ComboBoxItem x:Uid="Rarity_R">稀有</ComboBoxItem>
                            <ComboBoxItem x:Uid="Rarity_SR">精锐</ComboBoxItem>
                            <ComboBoxItem x:Uid="Rarity_SSR">超稀有</ComboBoxItem>
                            <ComboBoxItem x:Uid="Rarity_UR">海上传奇</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" x:Uid="BasicInfo_Category" Text="舰船类别:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CategoryCombo" Grid.Row="7" Grid.Column="1" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="Category_Normal">角色</ComboBoxItem>
                            <ComboBoxItem x:Uid="Category_Collab">联动</ComboBoxItem>
                            <ComboBoxItem x:Uid="Category_Research">科研</ComboBoxItem>
                            <ComboBoxItem x:Uid="Category_META1">META</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="8" Grid.Column="0" x:Uid="BasicInfo_CanRemodel" Text="可改造:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CanRemodelCheckBox" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" x:Uid="BasicInfo_RemodelDate" Text="改造日期:" VerticalAlignment="Center"/>
                        <DatePicker x:Name="RemodelDatePicker" Grid.Row="9" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=CanRemodelCheckBox}"/>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- 获取方式卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="Acquisition_Header" Text="获取方式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <!-- 动态条目列表 -->
                        <ItemsControl x:Name="AcquireEntriesItemsControl" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                <local:AcquireEntryControl Margin="0,4" DeleteRequested="OnEntryDeleteRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Uid="AddAcquireEntryButton" x:Name="AddAcquireEntryButton" Content="+ 添加获取方式" Click="AddAcquireEntry_Click" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="Acquisition_Main" Text="主要获取方式:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBox x:Name="AcquireMainZhBox" Header="简体中文"/>
                            <TextBox x:Name="AcquireMainZhHantBox" Header="繁體中文" Margin="0,8,0,0"/>
                            <TextBox x:Name="AcquireMainEnBox" Header="English" Margin="0,8,0,0"/>
                            <TextBox x:Name="AcquireMainJaBox" Header="日本語" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Acquisition_Detail" Text="详细信息:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBox x:Name="AcquireDetailZhBox" Header="简体中文"/>
                            <TextBox x:Name="AcquireDetailZhHantBox" Header="繁體中文" Margin="0,8,0,0"/>
                            <TextBox x:Name="AcquireDetailEnBox" Header="English" Margin="0,8,0,0"/>
                            <TextBox x:Name="AcquireDetailJaBox" Header="日本語" Margin="0,8,0,0"/>
                        </StackPanel>
                         -->
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="Acquisition_BuildTime" Text="建造时间:" VerticalAlignment="Center"/>
                        <TextBox x:Name="BuildTimeBox" Grid.Row="0" Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Acquisition_DropLocations" Text="打捞地点:" VerticalAlignment="Center"/>
                        <TextBox x:Name="DropLocationsBox" x:Uid="Acquisition_DropLocationsBox" Grid.Row="1" Grid.Column="1" PlaceholderText="分号分隔"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="Acquisition_ShopExchange" Text="商店兑换:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ShopExchangeBox" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" x:Uid="Acquisition_IsPermanent" Text="是否常驻:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="IsPermanentCheckBox" x:Uid="Acquisition_IsPermanentCheckBox" Grid.Row="3" Grid.Column="1" Content="常驻" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 实装活动卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="DebutEvent_Header" Text="实装活动" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="DebutEvent_Name" Text="首次登场活动:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBox x:Name="DebutEventZhBox" Header="简体中文"/>
                            <TextBox x:Name="DebutEventZhHantBox" Header="繁體中文" Margin="0,8,0,0"/>
                            <TextBox x:Name="DebutEventEnBox" Header="English" Margin="0,8,0,0"/>
                            <TextBox x:Name="DebutEventJaBox" Header="日本語" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="DebutEvent_Date" Text="实装日期:" VerticalAlignment="Center"/>
                        <DatePicker x:Name="ReleaseDatePicker" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" x:Uid="DebutEvent_Notes" Text="备注:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBox x:Name="NotesZhBox" Header="简体中文" AcceptsReturn="True" Height="60"/>
                            <TextBox x:Name="NotesZhHantBox" Header="繁體中文" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="NotesEnBox" Header="English" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="NotesJaBox" Header="日本語" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 属性加成卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="AttributeBonus_Header" Text="属性加成" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel>
                        <TextBlock x:Uid="AttributeBonus_Obtain" Text="获得时加成" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid RowSpacing="12" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 获得时属性选择 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="AttributeBonus_Attr" Text="属性:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ObtainBonusAttrCombo" Grid.Row="0" Grid.Column="1">
                                <ComboBoxItem x:Uid="Attr_Null">无</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_HP">耐久</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_FP">炮击</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_TRP">雷击</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_AA">防空</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_AVI">航空</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_ACC">命中</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_RLD">装填</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_EVA">机动</ComboBoxItem>
                                <ComboBoxItem x:Uid="Attr_ASW">反潜</ComboBoxItem>
                            </ComboBox>
                            <!-- 获得时数值 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="AttributeBonus_Value" Text="数值:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="ObtainBonusValueBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <TextBlock x:Uid="AttributeBonus_AffectShips" Text="适用舰种" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ObtainAffectDD" x:Uid="ShipClass_DD" Content="驱逐" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ObtainAffectCL" x:Uid="ShipClass_CL" Content="轻巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="ObtainAffectCA" x:Uid="ShipClass_CA" Content="重巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ObtainAffectCB" x:Uid="ShipClass_CB" Content="超巡" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ObtainAffectBM" x:Uid="ShipClass_BM" Content="重炮" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="ObtainAffectBC" x:Uid="ShipClass_BC" Content="战巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="ObtainAffectBB" x:Uid="ShipClass_BB" Content="战列" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ObtainAffectBBV" x:Uid="ShipClass_BBV" Content="航战" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" x:Name="ObtainAffectCV" x:Uid="ShipClass_CV" Content="航母" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="0" x:Name="ObtainAffectCVL" x:Uid="ShipClass_CVL" Content="轻航" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ObtainAffectAR" x:Uid="ShipClass_AR" Content="维修" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="2" x:Name="ObtainAffectSS" x:Uid="ShipClass_SS" Content="潜艇" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" x:Name="ObtainAffectSSV" x:Uid="ShipClass_SSV" Content="潜母" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ObtainAffectAE" x:Uid="ShipClass_AE" Content="运输" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="2" x:Name="ObtainAffectSail" x:Uid="ShipClass_Sail" Content="风帆" Margin="16,4,0,0" MaxWidth="80"/>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,16,0,16"/>
                        <TextBlock x:Uid="AttributeBonus_Level120" Text="120级属性:"  FontWeight="SemiBold" Margin="0,0,0,8" VerticalAlignment="Center"/>
                        <Grid RowSpacing="12" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="AttributeBonus_Attr" Grid.Row="0" Grid.Column="0" Text="属性:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="Level120BonusAttrCombo" Grid.Row="0" Grid.Column="1">
                                    <ComboBoxItem x:Uid="Attr_Null">无</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_HP">耐久</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_FP">炮击</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_TRP">雷击</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_AA">防空</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_AVI">航空</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_ACC">命中</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_RLD">装填</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_EVA">机动</ComboBoxItem>
                                    <ComboBoxItem x:Uid="Attr_ASW">反潜</ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Uid="AttributeBonus_Value" Grid.Row="1" Grid.Column="0" Text="数值:" VerticalAlignment="Center"/>
                            <NumberBox x:Name="Level120BonusValueBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <TextBlock x:Uid="AttributeBonus_AffectShips" Text="120级适用舰种" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="Level120AffectDD" x:Uid="ShipClass_DD" Content="驱逐" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="Level120AffectCL" x:Uid="ShipClass_CL" Content="轻巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="Level120AffectCA" x:Uid="ShipClass_CA" Content="重巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="Level120AffectCB" x:Uid="ShipClass_CB" Content="超巡" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="Level120AffectBM" x:Uid="ShipClass_BM" Content="重炮" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="Level120AffectBC" x:Uid="ShipClass_BC" Content="战巡" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="Level120AffectBB" x:Uid="ShipClass_BB" Content="战列" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="Level120AffectBBV" x:Uid="ShipClass_BBV" Content="航战" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" x:Name="Level120AffectCV" x:Uid="ShipClass_CV" Content="航母" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="0" x:Name="Level120AffectCVL" x:Uid="ShipClass_CVL" Content="轻航" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="Level120AffectAR" x:Uid="ShipClass_AR" Content="维修" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="3" Grid.Column="2" x:Name="Level120AffectSS" x:Uid="ShipClass_SS" Content="潜艇" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" x:Name="Level120AffectSSV" x:Uid="ShipClass_SSV" Content="潜母" Margin="0,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="Level120AffectAE" x:Uid="ShipClass_AE" Content="运输" Margin="16,4,0,0" MaxWidth="80"/>
                            <CheckBox Grid.Row="4" Grid.Column="2" x:Name="Level120AffectSail" x:Uid="ShipClass_Sail" Content="风帆" Margin="16,4,0,0" MaxWidth="80"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 舰队科技卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="FleetTech_Header" Text="舰队科技" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="FleetTech_ObtainPoints" Grid.Row="0" Grid.Column="0" Text="获得科技点:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="TechPointsObtainBox" Grid.Row="0" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        <TextBlock x:Uid="FleetTech_MaxPoints" Grid.Row="1" Grid.Column="0" Text="满破科技点:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="TechPointsMaxBox" Grid.Row="1" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                        <TextBlock x:Uid="FleetTech_Level120Points" Grid.Row="2" Grid.Column="0" Text="120级科技点:" VerticalAlignment="Center"/>
                        <NumberBox x:Name="TechPoints120Box" Grid.Row="2" Grid.Column="1" Minimum="0" Value="0" SpinButtonPlacementMode="Inline"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 特殊兵装卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock x:Uid="SpecialGear_Header" Text="专属兵装" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox x:Uid="SpecialGear_CanHave" x:Name="CanSpecialGearCheckBox" Content="可拥有专属兵装" Margin="0,0,0,8"/>
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SpecialGear_Name" Grid.Row="0" Grid.Column="0" Text="兵装名称:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBox x:Name="SpecialGearNameZhBox" Header="简体中文" AcceptsReturn="True" Height="60"/>
                            <TextBox x:Name="SpecialGearNameZhHantBox" Header="繁體中文" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="SpecialGearNameEnBox" Header="English" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="SpecialGearNameJaBox" Header="日本語" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Uid="SpecialGear_Date" Grid.Row="1" Grid.Column="0" Text="实装日期:" VerticalAlignment="Center"/>
                        <DatePicker x:Name="SpecialGearDatePicker" Grid.Row="1" Grid.Column="1" IsEnabled="False"/>
                        <TextBlock x:Uid="SpecialGear_Acquire" Grid.Row="2" Grid.Column="0" Text="获取途径:" VerticalAlignment="Top"/>
                        <ComboBox x:Name="SpecialGearTypeCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" IsEnabled="False" SelectionChanged="SpecialGearTypeCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="gear_1" Content="兵装制造" Tag="gear_1"/>
                            <ComboBoxItem x:Uid="gear_2" Content="活动获取" Tag="gear_2"/>
                            <ComboBoxItem x:Uid="gear_3" Content="限时制造" Tag="gear_3"/>
                            <ComboBoxItem x:Uid="gear_4" Content="商店 PT 兑换" Tag="gear_4"/>
                            <ComboBoxItem x:Uid="gear_5" Content="活动任务奖励" Tag="gear_5"/>
                            <ComboBoxItem x:Uid="gear_custom" Content="自定义文本" Tag="gear_custom"/>
                        </ComboBox>
                        <StackPanel Grid.Row="3" Grid.Column="1" x:Name="DynamicParamPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBox x:Name="Param1Box" Header="参数1" Margin="0,0,0,8"/>
                                <TextBox x:Name="Param2Box" Header="参数2" PlaceholderText="例如：8000"/>
                        </StackPanel>
                        <!-- 自定义文本面板（多语言） -->
                        <StackPanel Grid.Row="3" Grid.Column="1" x:Name="CustomTextPanel" Visibility="Collapsed">
                            <TextBlock Text="自定义文本 (多语言)" Margin="0,0,0,4"/>
                            <TextBox x:Name="CustomTextZhBox" Header="简体中文" AcceptsReturn="True" Height="60"/>
                            <TextBox x:Name="CustomTextZhHantBox" Header="繁體中文" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="CustomTextEnBox" Header="English" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                            <TextBox x:Name="CustomTextJaBox" Header="日本語" AcceptsReturn="True" Height="60" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>