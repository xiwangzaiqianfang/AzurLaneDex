<UserControl
    x:Class="AzurLaneDex.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
            <StackPanel Margin="10">

                <!-- 舰种 -->
                <StackPanel BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Width="477">
                    <Expander x:Uid="FilterTitle_Class" Header="舰种" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <CheckBox x:Uid="ShipType_DD" Content="驱逐" Tag="DD" x:Name="ShipTypeDD" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_CL" Content="轻巡" Tag="CL" x:Name="ShipTypeCL" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_CA" Content="重巡" Tag="CA" x:Name="ShipTypeCA" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <CheckBox x:Uid="ShipType_CB" Content="超巡" Tag="CB" x:Name="ShipTypeCB" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_BM" Content="重炮" Tag="BM" x:Name="ShipTypeBM" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_BC" Content="战巡" Tag="BC" x:Name="ShipTypeBC" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Uid="ShipType_BB" Content="战列" Tag="BB" x:Name="ShipTypeBB" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_BBV" Content="航战" Tag="BBV" x:Name="ShipTypeBBV" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_CV" Content="航母" Tag="CV" x:Name="ShipTypeCV" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <CheckBox x:Uid="ShipType_CVL" Content="轻航" Tag="CVL" x:Name="ShipTypeCVL" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_AR" Content="维修" Tag="AR" x:Name="ShipTypeAR" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_SS" Content="潜艇" Tag="SS" x:Name="ShipTypeSS" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <CheckBox x:Uid="ShipType_SSV" Content="潜母" Tag="SSV" x:Name="ShipTypeSSV" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_AE" Content="运输" Tag="AE" x:Name="ShipTypeAE" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="ShipType_Sail" Content="风帆" Tag="Sail" x:Name="ShipTypeSail" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>

                <!-- 阵营 -->
                <StackPanel BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Width="477">
                    <Expander x:Uid="FilterTitle_Faction" Header="阵营" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True" Margin="0,5,0,5">
                        <Grid>
                            <Grid x:Name="NormalFactionPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_EagleUnion" Content="白鹰" Tag="EagleUnion" x:Name="FactionEU" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_RoyalNavy" Content="皇家" Tag="RoyalNavy" x:Name="FactionRN" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_SakuraEmpire" Content="重樱" Tag="SakuraEmpire" x:Name="FactionIJN" Margin="8,4,6,4" Width="80"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_IronBlood" Content="铁血" Tag="IronBlood" x:Name="FactionKMS" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_DragonEmpery" Content="东煌" Tag="DragonEmpery" x:Name="FactionDragon" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_NorthernUnion" Content="北方联合" Tag="NorthernUnion" x:Name="FactionSN" Margin="8,4,6,4" Width="80"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_FreeFrench" Content="自由鸢尾" Tag="FreeFrench" x:Name="FactionFFNF" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_Vichya" Content="维希教廷" Tag="Vichya" x:Name="FactionMNF" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_Sardegna" Content="撒丁帝国" Tag="Sardegna" x:Name="FactionSardegna" Margin="8,4,6,4" Width="80"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Tulip" Content="郁金王国" Tag="Tulip" x:Name="FactionTulip" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_CrystalLeague" Content="晶环联盟" Tag="CrystalLeague" x:Name="FactionCrystalLeague" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_Tempesta" Content="飓风" Tag="Tempesta" x:Name="FactionTempesta" Margin="8,4,6,4" Width="80"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_META" Content="META" Tag="META" x:Name="FactionMETA" Margin="8,4,6,4" Width="80"/>
                                    <CheckBox x:Uid="Faction_Other" Content="其他" Tag="Other" x:Name="FactionOther" Margin="8,4,6,4" Width="80"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="CollabFactionPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_Nep" Content="超次元游戏海王星" Tag="Collab_Nep" x:Name="FactionCollab_Nep" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Bilibili" Content="哔哩哔哩" Tag="Collab_Bilibili" x:Name="FactionCollab_Bilibili" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Utawarerumono" Content="传颂之物" Tag="Collab_Utawarerumono" x:Name="FactionCollab_Utawarerumono" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_KizunaAI" Content="绊爱" Tag="Collab_KizunaAI" x:Name="FactionCollab_KizunaAI" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Hololive" Content="Hololive" Tag="Collab_Hololive" x:Name="FactionCollab_Hololive" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_DoAXVV" Content="死或生沙滩排球" Tag="Collab_DoAXVV" x:Name="FactionCollab_DoAXVV" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_Idolmaster" Content="偶像大师" Tag="Collab_Idolmaster" x:Name="FactionCollab_Idolmaster" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_SSSS" Content="SSSS" Tag="Collab_SSSS" x:Name="FactionCollab_SSSS" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Ryza" Content="莱莎的炼金工房" Tag="Collab_Ryza" x:Name="FactionCollab_Ryza" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_Senran" Content="闪乱神乐" Tag="Collab_Senran" x:Name="FactionCollab_Senran" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Toloveru" Content="出包王女" Tag="Collab_Toloveru" x:Name="FactionCollab_Toloveru" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_BRS" Content="黑岩射手" Tag="Collab_BRS" x:Name="FactionCollab_BRS" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_Danmachi" Content="地城邂逅" Tag="Collab_Danmachi" x:Name="FactionCollab_Danmachi" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_Yumia" Content="优米雅的炼金工房" Tag="Collab_Yumia" x:Name="FactionCollab_Yumia" Margin="6,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Collab_DAL" Content="约会大作战V" Tag="Collab_DAL" x:Name="FactionCollab_DAL" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="5" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Collab_NieR" Content="尼尔：机械纪元" Tag="Collab_NieR" x:Name="FactionCollab_NieR" Margin="6,4,6,4" Width="110"/>
                                </StackPanel>
                            </Grid>
                            <!-- META阵营面板 -->
                            <Grid x:Name="MetaFactionPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Meta_Flame" Content="破敌之炬" Tag="Meta_Flame" x:Name="FactionMeta_Flame" Margin="8,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Meta_Core" Content="湮烬之核" Tag="Meta_Core" x:Name="FactionMeta_Core" Margin="8,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Meta_Reason" Content="构造之理" Tag="Meta_Reason" x:Name="FactionMeta_Reason" Margin="8,4,6,4" Width="110"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <CheckBox x:Uid="Faction_Meta_Light" Content="逐光之焰" Tag="Meta_Light" x:Name="FactionMeta_Light" Margin="8,4,6,4" Width="110"/>
                                    <CheckBox x:Uid="Faction_Meta_Fire" Content="摇曳之火" Tag="Meta_Fire" x:Name="FactionMeta_Fire" Margin="8,4,6,4" Width="110"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>

                <!-- 稀有度 -->
                <StackPanel BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Width="477">
                    <Expander x:Uid="FilterTitle_Rarity" Header="稀有度" HorizontalAlignment="Stretch" IsExpanded="True" Margin="0,5,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <CheckBox x:Uid="Rarity_N" Content="普通" Tag="N" x:Name="RarityNormal" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Rarity_R" Content="稀有" Tag="R" x:Name="RarityRare" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Rarity_SR" Content="精锐" Tag="SR" x:Name="RarityElite" Margin="8,4,6,4" Width="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <CheckBox x:Uid="Rarity_SSR" Content="超稀有" Tag="SSR" x:Name="RaritySuperRare" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Rarity_UR" Content="海上传奇" Tag="UR" x:Name="RarityLegendary" Margin="8,4,6,4" Width="90"/>
                                <CheckBox x:Uid="Rarity_Decisive" Content="最高方案" Tag="Decisive" x:Name="RarityDecisive" Margin="8,4,6,4" Width="90"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Uid="Rarity_Ultimate" Content="决战方案" Tag="Ultimate" x:Name="RarityUltimate" Margin="8,4,6,4" Width="90"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>

                <!-- 附加状态 -->
                <StackPanel BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Width="477">
                    <Expander x:Uid="FilterTitle_Extra" Header="附加状态" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True" Margin="0,5,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <CheckBox x:Uid="Extra_CanRemodel" Content="可改造" x:Name="ExtraCanRemodel" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_Remodeled" Content="已改造" x:Name="ExtraRemodeled" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_MaxBreak" Content="已满破" x:Name="ExtraMaxBreak" Margin="8,4,6,4" Width="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <CheckBox x:Uid="Extra_NotMaxBreak" Content="未满破" x:Name="ExtraNotMaxBreak" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_Level120" Content="已120级" x:Name="ExtraLevel120" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_NotLevel120" Content="未120级" x:Name="ExtraNotLevel120" Margin="8,4,6,4" Width="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Uid="Extra_Oath" Content="已誓约" x:Name="ExtraOath" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_NotOath" Content="未誓约" x:Name="ExtraNotOath" Margin="8,4,6,4" Width="80"/>
                                <CheckBox x:Uid="Extra_CanSpecial" Content="可拥有特殊兵装" x:Name="ExtraCanSpecial" Margin="8,4,6,4" Width="110"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <CheckBox x:Uid="Extra_SpecialObtained" Content="已拥有特殊兵装" x:Name="ExtraSpecialObtained" Margin="8,4,6,4" Width="110"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>

                <!-- 属性加成（使用 AttributeType 枚举） -->
                <StackPanel BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Width="477">
                    <Expander x:Uid="FilterTitle_AttributeBonus" Header="属性加成" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsExpanded="True" Margin="0,5,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <CheckBox x:Uid="Attr_FP" Content="炮击" Tag="FP" x:Name="AttrFirepower" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="Attr_AVI" Content="航空" Tag="AVI" x:Name="AttrAviation" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="Attr_EVA" Content="机动" Tag="EVA" x:Name="AttrMobility" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <CheckBox x:Uid="Attr_AA" Content="防空" Tag="AA" x:Name="AttrAA" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="Attr_TRP" Content="雷击" Tag="TRP" x:Name="AttrTorpedo" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="Attr_RLD" Content="装填" Tag="RLD" x:Name="AttrReload" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Uid="Attr_HP" Content="耐久" Tag="HP" x:Name="AttrDurability" Margin="8,4,6,4" Width="50"/>
                                <CheckBox x:Uid="Attr_ASW" Content="反潜" Tag="ASW" x:Name="AttrAntiSub" Margin="8,4,6,4" Width="50"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>